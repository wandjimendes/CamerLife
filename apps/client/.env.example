VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Colyseus endpoint (ws://localhost:2567 locally, wss://cameroon-life-server.fly.dev in prod)
VITE_COLYSEUS_URL=ws://localhost:2567
# Local dev without CORS (e.g. behind a tunnel / cloud preview): use the Vite
# proxies instead - see vite.config.ts and `npm run dev:db`.
#   VITE_SUPABASE_URL=/supabase
#   VITE_COLYSEUS_URL=/colyseus
